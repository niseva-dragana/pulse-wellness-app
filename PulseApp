              </div>
            </div>
            <div className="glass" style={{ padding: 16, display: "flex", gap: 12, alignItems: "center" }}>
              <TrendingUp size={15} color="#FFB347" />
              <span style={{ fontSize: 13, color: "rgba(232,240,255,0.5)", lineHeight: 1.5 }}>
                Only <strong style={{ color: "#E8F0FF" }}>12–28%</strong> of teens meet the 60-min daily activity guideline (HBSC 2022)
              </span>
            </div>
          </div>
        ),
      },
    ];

    const cur = steps[step];
    const pct = Math.round(((step + 1) / steps.length) * 100);

    return (
      <div className="fade-up" style={{ padding: "0 20px 110px" }}>
        {/* Top bar */}
        <div style={{ display: "flex", alignItems: "center", gap: 14, padding: "22px 0 28px" }}>
          <button className="ghost-btn" style={{ padding: "10px 12px" }}
            onClick={() => step === 0 ? setScreen("home") : setStep(s => s - 1)}>
            <ArrowLeft size={18} />
          </button>
          <div style={{ flex: 1 }}>
            <div style={{ display: "flex", justifyContent: "space-between", marginBottom: 7 }}>
              <span style={{ fontSize: 12, color: "rgba(232,240,255,0.35)" }}>Step {step + 1} of {steps.length}</span>
              <span style={{ fontSize: 12, color: "#00E5A8", fontWeight: 600 }}>{pct}%</span>
            </div>
            <div style={{ height: 4, background: "rgba(255,255,255,0.08)", borderRadius: 2 }}>
              <div style={{ height: "100%", width: `${pct}%`, background: "linear-gradient(90deg,#00E5A8,#00C8FF)", borderRadius: 2, transition: "width 0.4s ease" }} />
            </div>
          </div>
        </div>

        <h2 style={{ fontSize: "clamp(20px,5.5vw,26px)", fontWeight: 700, letterSpacing: "-0.5px", marginBottom: 6 }}>{cur.title}</h2>
        <p style={{ fontSize: 14, color: "rgba(232,240,255,0.45)" }}>{cur.sub}</p>

        {cur.content}

        <button className="cta" style={{ marginTop: 32 }} disabled={!cur.canNext}
          onClick={() => step < steps.length - 1 ? setStep(s => s + 1) : callAI()}>
          {step < steps.length - 1
            ? <><span>Continue</span><ChevronRight size={16} /></>
            : <><Sparkles size={16} /><span>Analyze with AI</span></>}
        </button>
      </div>
    );
  };

  // ══════════════════════════════════════════════════════════════════════════
  // SCREEN: INSIGHTS
  // ══════════════════════════════════════════════════════════════════════════
  const InsightsScreen = () => {
    if (loading) return (
      <div style={{ display: "flex", flexDirection: "column", alignItems: "center", justifyContent: "center", minHeight: "72vh", gap: 20 }}>
        <div style={{ width: 56, height: 56, border: "3px solid rgba(0,229,168,0.18)", borderTop: "3px solid #00E5A8", borderRadius: "50%", animation: "spin 0.9s linear infinite" }} />
        <div style={{ textAlign: "center" }}>
          <div style={{ fontWeight: 600, fontSize: 16, marginBottom: 6 }}>Analyzing your check-in…</div>
          <div style={{ fontSize: 13, color: "rgba(232,240,255,0.38)" }}>AI is processing with HBSC context</div>
        </div>
      </div>
    );

    if (!insights) return (
      <div style={{ display: "flex", flexDirection: "column", alignItems: "center", justifyContent: "center", minHeight: "72vh", gap: 16, padding: "0 24px", textAlign: "center" }}>
        <Brain size={36} color="rgba(232,240,255,0.3)" />
        <p style={{ color: "rgba(232,240,255,0.4)", fontSize: 14 }}>Complete a check-in first to see your AI insights.</p>
        <button className="cta" style={{ maxWidth: 240 }} onClick={() => { setScreen("checkin"); setStep(0); setData({ mood: null, sleep: 7, stress: 5, social: 6, activity: 5 }); }}>
          Start check-in
        </button>
      </div>
    );

    const scoreColor = insights.overallScore >= 70 ? "#00E5A8" : insights.overallScore >= 48 ? "#FFB347" : "#FF6B6B";
    const r = 52;
    const circ = 2 * Math.PI * r;
    const offset = circ - (insights.overallScore / 100) * circ;

    return (
      <div className="fade-up" style={{ padding: "0 20px 110px" }}>
        <div style={{ display: "flex", alignItems: "center", gap: 10, padding: "24px 0 28px" }}>
          <Sparkles size={18} color="#00E5A8" />
          <span style={{ fontWeight: 700, fontSize: 18 }}>Your AI insights</span>
        </div>

        {/* Score card */}
        <div className="glass-hi fade-up" style={{ padding: "32px 24px", textAlign: "center", marginBottom: 16 }}>
          <svg width="128" height="128" style={{ margin: "0 auto 20px", display: "block" }}>
            <circle cx="64" cy="64" r={r} fill="none" stroke="rgba(255,255,255,0.07)" strokeWidth="7" />
            <circle cx="64" cy="64" r={r} fill="none" stroke={scoreColor} strokeWidth="7"
              strokeDasharray={circ}
              strokeDashoffset={offset}
              strokeLinecap="round"
              transform="rotate(-90 64 64)"
              style={{ transition: "stroke-dashoffset 1.4s cubic-bezier(0.34,1.56,0.64,1)", filter: `drop-shadow(0 0 8px ${scoreColor}88)` }} />
            <text x="64" y="57" textAnchor="middle" fill={scoreColor} fontSize="30" fontWeight="800" fontFamily="Sora">{insights.overallScore}</text>
            <text x="64" y="76" textAnchor="middle" fill="rgba(232,240,255,0.38)" fontSize="11" fontFamily="Sora">wellness score</text>
          </svg>
          <p style={{ fontSize: 16, fontWeight: 500, letterSpacing: "-0.2px", lineHeight: 1.55, color: "rgba(232,240,255,0.9)", fontStyle: "italic" }}>
            "{insights.headline}"
          </p>
        </div>

        {/* Insight cards */}
        {insights.insights.map((ins, i) => {
          const c = insightColors[ins.type] || insightColors.neutral;
          return (
            <div key={i} className={`insight-card ${c.bg} fade-up`} style={{ animationDelay: `${0.1 + i * 0.08}s` }}>
              <div style={{ display: "flex", alignItems: "center", gap: 10, marginBottom: 10 }}>
                <div style={{ color: c.icon, display: "flex" }}>{icons[ins.icon] || <Brain size={18} />}</div>
                <span style={{ fontWeight: 600, fontSize: 14 }}>{ins.title}</span>
              </div>
              <p style={{ fontSize: 13.5, color: "rgba(232,240,255,0.6)", lineHeight: 1.65 }}>{ins.body}</p>
            </div>
          );
        })}

        {/* Challenge */}
        <div className="glass fade-up d4" style={{ padding: 22, marginBottom: 12 }}>
          <div style={{ fontSize: 11, color: "#00E5A8", fontWeight: 700, letterSpacing: "0.8px", textTransform: "uppercase", marginBottom: 10 }}>
            Today's challenge
          </div>
          <p style={{ fontSize: 15, fontWeight: 500, lineHeight: 1.55 }}>{insights.challenge}</p>
        </div>

        {/* Affirmation */}
        <p className="fade-up d5" style={{ textAlign: "center", color: "rgba(232,240,255,0.38)", fontSize: 13, fontStyle: "italic", padding: "8px 0 20px" }}>
          ✦ {insights.affirmation}
        </p>

        <button className="cta fade-up d6" onClick={() => setScreen("explorer")}>
          <BarChart2 size={16} /> Explore HBSC Data
        </button>
      </div>
    );
  };

  // ══════════════════════════════════════════════════════════════════════════
  // SCREEN: EXPLORER
  // ══════════════════════════════════════════════════════════════════════════
  const ExplorerScreen = () => (
    <div className="fade-up" style={{ padding: "0 20px 110px" }}>
      <div style={{ padding: "24px 0 28px" }}>
        <div style={{ display: "flex", alignItems: "center", gap: 10, marginBottom: 4 }}>
          <BarChart2 size={20} color="#00E5A8" />
          <span style={{ fontWeight: 700, fontSize: 19 }}>HBSC Data Explorer</span>
        </div>
        <p style={{ fontSize: 12, color: "rgba(232,240,255,0.36)" }}>Health Behaviour in School-aged Children · International Study · hbsc.org</p>
      </div>

      {/* Chart 1: Life Satisfaction */}
      <div className="glass fade-up" style={{ padding: "22px 20px", marginBottom: 14 }}>
        <div style={{ marginBottom: 16 }}>
          <div style={{ fontWeight: 600, fontSize: 14, marginBottom: 3 }}>Life Satisfaction by Age</div>
          <div style={{ fontSize: 12, color: "rgba(232,240,255,0.38)" }}>% reporting high satisfaction · by gender</div>
        </div>
        <ResponsiveContainer width="100%" height={190}>
          <BarChart data={satisfactionData} barGap={4} barCategoryGap="35%">
            <CartesianGrid strokeDasharray="3 3" stroke="rgba(255,255,255,0.05)" vertical={false} />
            <XAxis dataKey="age" tick={{ fill: "rgba(232,240,255,0.38)", fontSize: 12 }} axisLine={false} tickLine={false} />
            <YAxis tick={{ fill: "rgba(232,240,255,0.38)", fontSize: 11 }} axisLine={false} tickLine={false} domain={[40, 80]} tickFormatter={v => `${v}%`} />
            <Tooltip content={<CustomTooltip />} />
            <Bar dataKey="boys" name="Boys" fill="#00C8FF" radius={[6, 6, 0, 0]} />
            <Bar dataKey="girls" name="Girls" fill="#FF6B6B" radius={[6, 6, 0, 0]} />
          </BarChart>
        </ResponsiveContainer>
        <div style={{ display: "flex", gap: 16, marginTop: 10 }}>
          {[["#00C8FF", "Boys"], ["#FF6B6B", "Girls"]].map(([c, l]) => (
            <div key={l} style={{ display: "flex", alignItems: "center", gap: 6, fontSize: 12, color: "rgba(232,240,255,0.45)" }}>
              <div style={{ width: 10, height: 10, borderRadius: 2, background: c }} />{l}
            </div>
          ))}
        </div>
      </div>

      {/* Chart 2: Sleep */}
      <div className="glass fade-up d1" style={{ padding: "22px 20px", marginBottom: 14 }}>
        <div style={{ marginBottom: 16 }}>
          <div style={{ fontWeight: 600, fontSize: 14, marginBottom: 3 }}>Average Sleep Hours</div>
          <div style={{ fontSize: 12, color: "rgba(232,240,255,0.38)" }}>Actual vs recommended · by age group</div>
        </div>
        <ResponsiveContainer width="100%" height={190}>
          <BarChart data={sleepData} barGap={4} barCategoryGap="35%">
            <CartesianGrid strokeDasharray="3 3" stroke="rgba(255,255,255,0.05)" vertical={false} />
            <XAxis dataKey="label" tick={{ fill: "rgba(232,240,255,0.38)", fontSize: 12 }} axisLine={false} tickLine={false} />
            <YAxis tick={{ fill: "rgba(232,240,255,0.38)", fontSize: 11 }} axisLine={false} tickLine={false} domain={[6, 11]} tickFormatter={v => `${v}h`} />
            <Tooltip content={<CustomTooltip />} />
            <Bar dataKey="actual" name="Actual sleep" fill="#7C6FF7" radius={[6, 6, 0, 0]} />
            <Bar dataKey="target" name="Recommended" fill="rgba(0,229,168,0.35)" radius={[6, 6, 0, 0]} />
          </BarChart>
        </ResponsiveContainer>
        <div style={{ display: "flex", gap: 16, marginTop: 10 }}>
          {[["#7C6FF7", "Actual"], ["rgba(0,229,168,0.5)", "Recommended"]].map(([c, l]) => (
            <div key={l} style={{ display: "flex", alignItems: "center", gap: 6, fontSize: 12, color: "rgba(232,240,255,0.45)" }}>
              <div style={{ width: 10, height: 10, borderRadius: 2, background: c }} />{l}
            </div>
          ))}
        </div>
      </div>

      {/* Chart 3: Stress Sources */}
      <div className="glass fade-up d2" style={{ padding: "22px 20px", marginBottom: 14 }}>
        <div style={{ marginBottom: 16 }}>
          <div style={{ fontWeight: 600, fontSize: 14, marginBottom: 3 }}>Top Stress Sources</div>
          <div style={{ fontSize: 12, color: "rgba(232,240,255,0.38)" }}>% of teens citing each · age 11–15</div>
        </div>
        <div style={{ display: "flex", alignItems: "center", gap: 10 }}>
          <ResponsiveContainer width={130} height={130}>
            <PieChart>
              <Pie data={stressData} cx={60} cy={60} innerRadius={36} outerRadius={58} dataKey="value" paddingAngle={3}>
                {stressData.map((e, i) => <Cell key={i} fill={e.color} />)}
              </Pie>
            </PieChart>
          </ResponsiveContainer>
          <div style={{ flex: 1 }}>
            {stressData.map((item, i) => (
              <div key={i} style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: 10 }}>
                <div style={{ display: "flex", alignItems: "center", gap: 7 }}>
                  <div style={{ width: 8, height: 8, borderRadius: "50%", background: item.color, flexShrink: 0 }} />
                  <span style={{ fontSize: 13, color: "rgba(232,240,255,0.55)" }}>{item.name}</span>
                </div>
                <span style={{ fontSize: 13, fontWeight: 700, color: item.color }}>{item.value}%</span>
              </div>
            ))}
          </div>
        </div>
      </div>

      {/* Chart 4: Physical Activity */}
      <div className="glass fade-up d3" style={{ padding: "22px 20px", marginBottom: 14 }}>
        <div style={{ marginBottom: 16 }}>
          <div style={{ fontWeight: 600, fontSize: 14, marginBottom: 3 }}>Meeting Activity Guidelines</div>
          <div style={{ fontSize: 12, color: "rgba(232,240,255,0.38)" }}>% meeting 60 min/day · by age & gender</div>
        </div>
        <ResponsiveContainer width="100%" height={210}>
          <BarChart data={activityData} layout="vertical" barSize={14}>
            <CartesianGrid strokeDasharray="3 3" stroke="rgba(255,255,255,0.05)" horizontal={false} />
            <XAxis type="number" tick={{ fill: "rgba(232,240,255,0.38)", fontSize: 11 }} axisLine={false} tickLine={false} domain={[0, 34]} tickFormatter={v => `${v}%`} />
            <YAxis type="category" dataKey="group" tick={{ fill: "rgba(232,240,255,0.45)", fontSize: 12 }} axisLine={false} tickLine={false} width={72} />
            <Tooltip content={<CustomTooltip />} />
            <Bar dataKey="pct" name="Meeting guidelines" fill="#FFB347" radius={[0, 6, 6, 0]} />
          </BarChart>
        </ResponsiveContainer>
      </div>

      {/* Chart 5: Mental health symptoms */}
      <div className="glass fade-up d4" style={{ padding: "22px 20px" }}>
        <div style={{ marginBottom: 20 }}>
          <div style={{ fontWeight: 600, fontSize: 14, marginBottom: 3 }}>Weekly Mental Health Symptoms</div>
          <div style={{ fontSize: 12, color: "rgba(232,240,255,0.38)" }}>% experiencing weekly · age 11–15</div>
        </div>
        {symptomData.map((item, i) => (
          <div key={i} style={{ marginBottom: i < symptomData.length - 1 ? 18 : 0 }}>
            <div style={{ display: "flex", justifyContent: "space-between", marginBottom: 7, alignItems: "center" }}>
              <span style={{ fontSize: 13.5, color: "rgba(232,240,255,0.65)" }}>{item.s}</span>
              <span style={{ fontSize: 13.5, fontWeight: 700, color: "#E8F0FF" }}>{item.p}%</span>
            </div>
            <div style={{ height: 6, background: "rgba(255,255,255,0.08)", borderRadius: 3 }}>
              <div style={{
                height: "100%",
                width: `${item.p}%`,
                background: `linear-gradient(90deg, #7C6FF7, #FF6B6B)`,
                borderRadius: 3,
                transition: "width 1.2s cubic-bezier(0.34,1.56,0.64,1)",
                transitionDelay: `${i * 0.08}s`,
              }} />
            </div>
          </div>
        ))}
      </div>
    </div>
  );

  // ══════════════════════════════════════════════════════════════════════════
  // ROOT RENDER
  // ══════════════════════════════════════════════════════════════════════════
  return (
    <div style={{ minHeight: "100vh", background: "#06080F", color: "#E8F0FF", fontFamily: "'Sora',system-ui,sans-serif", position: "relative", maxWidth: 520, margin: "0 auto" }}>
      {/* Ambient blobs */}
      <div className="blob" style={{ width: 380, height: 380, background: "rgba(0,229,168,0.065)", top: -80, right: -90 }} />
      <div className="blob" style={{ width: 280, height: 280, background: "rgba(124,111,247,0.075)", bottom: 240, left: -70, animationDelay: "3.5s" }} />
      <div className="blob" style={{ width: 220, height: 220, background: "rgba(255,107,107,0.055)", top: "55%", right: -50, animationDelay: "6.5s" }} />

      {/* Screen content */}
      <div style={{ position: "relative", zIndex: 1 }}>
        {screen === "home"     && <HomeScreen />}
        {screen === "checkin"  && <CheckinScreen />}
        {screen === "insights" && <InsightsScreen />}
        {screen === "explorer" && <ExplorerScreen />}
      </div>

      {/* Bottom navigation */}
      <div style={{ position: "fixed", bottom: 0, left: "50%", transform: "translateX(-50%)", width: "100%", maxWidth: 520, background: "rgba(6,8,15,0.92)", borderTop: "1px solid rgba(255,255,255,0.08)", backdropFilter: "blur(24px)", padding: "10px 0 18px", zIndex: 200 }}>
        <div style={{ display: "flex", justifyContent: "space-around" }}>
          {[
            { id: "home",     icon: <Heart size={20} />,    label: "Home"    },
            { id: "checkin",  icon: <Activity size={20} />, label: "Check in"},
            { id: "insights", icon: <Brain size={20} />,    label: "Insights"},
            { id: "explorer", icon: <BarChart2 size={20} />,label: "Explore" },
          ].map(n => (
            <button key={n.id} className={`nav-tab ${screen === n.id ? "on" : ""}`} onClick={() => setScreen(n.id)}>
              {n.icon}
              {n.label}
            </button>
          ))}
        </div>
      </div>
    </div>
  );
}
